{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(./src/**)",
      "Edit(./tests/**)",
      "Edit(./docs/**)",
      "Write(./src/**)",
      "Write(./tests/**)",
      "Write(./docs/**)",
      "Edit(./.worktrees/*/src/**)",
      "Edit(./.worktrees/*/tests/**)",
      "Write(./.worktrees/*/src/**)",
      "Write(./.worktrees/*/tests/**)",
      "Bash(git fetch:*)",
      "Bash(git worktree add .worktrees/:*)",
      "Bash(git worktree list)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr create --base main --head agent/*)",
      "Bash(git -C .worktrees/* status*)",
      "Bash(git -C .worktrees/* diff *)",
      "Bash(git -C .worktrees/* log *)",
      "Bash(git -C .worktrees/* add *)",
      "Bash(git -C .worktrees/* commit *)",
      "Bash(git -C .worktrees/* push -u origin agent/*)",
      "Bash(git -C .worktrees/* push origin agent/*)",
      "Bash(npm --prefix .worktrees/* ci)",
      "Bash(npm --prefix .worktrees/* run *)",
      "Bash(npm run check)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run guards)",
      "Bash(npm ci)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch -c agent/:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Edit(./package.json)",
      "Edit(./eslint.config.js)",
      "Edit(./tsconfig.json)",
      "Edit(./.github/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)"
    ]
  }
}
